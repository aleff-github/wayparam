#!/usr/bin/make -f

export PYBUILD_NAME=wayparam
# The test suite is fully offline (httpx.MockTransport), so it is safe to run
# it during the build.
export PYBUILD_TEST_PYTEST=1

%:
	dh $@ --with python3 --buildsystem=pybuild

# pybuild installs the whole distribution into debian/wayparam, and does not
# honour a --destdir of debian/tmp, so the optional web UI is split out here
# explicitly rather than through .install globs.
GUI_PKGDIR = usr/lib/python3/dist-packages/wayparam/gui

override_dh_install:
	dh_install
	mkdir -p debian/wayparam-gui/usr/bin \
	         debian/wayparam-gui/usr/lib/python3/dist-packages/wayparam
	mv debian/wayparam/usr/bin/wayparam-gui debian/wayparam-gui/usr/bin/
	mv debian/wayparam/$(GUI_PKGDIR) debian/wayparam-gui/$(GUI_PKGDIR)

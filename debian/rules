#!/usr/bin/make -f

export PYBUILD_NAME=wayparam
# The test suite is fully offline (httpx.MockTransport), so it is safe to run
# it during the build.
export PYBUILD_TEST_PYTEST=1

%:
	dh $@ --with python3 --buildsystem=pybuild

# Two binary packages are built from this source, so stage everything in
# debian/tmp and let the .install files decide what lands where.
override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp

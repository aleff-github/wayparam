#!/usr/bin/make -f

export PYBUILD_NAME=wayparam
# The test suite is fully offline (httpx.MockTransport), so it is safe to run
# it during the build.
export PYBUILD_TEST_PYTEST=1
# Without this, pybuild stages into debian/python3-wayparam -- a package this
# source does not build -- and the wayparam package would ship empty.
export PYBUILD_DESTDIR=debian/wayparam

%:
	dh $@ --with python3 --buildsystem=pybuild

# The optional web UI ships in its own binary package. The staged
# dist-packages path is interpreter-versioned at this point, so the directory
# is located rather than hardcoded, and the whole tree is dumped if anything
# is not where it should be.
# Installed as the upstream changelog rather than shipped as a doc file,
# which is what lintian's wrong-name-for-upstream-changelog asks for.
override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md

override_dh_install:
	dh_install
	set -e; \
	script=debian/wayparam/usr/bin/wayparam-gui; \
	pkgdir=$$(find debian/wayparam -type d -path '*/dist-packages/wayparam/gui' | head -1); \
	if [ ! -f "$$script" ] || [ -z "$$pkgdir" ]; then \
		echo "ERROR: web UI not staged where expected. Tree under debian/:"; \
		find debian -maxdepth 9 -not -path '*/.debhelper/*' | sort; \
		exit 1; \
	fi; \
	dest="debian/wayparam-gui/$${pkgdir#debian/wayparam/}"; \
	echo "moving $$pkgdir -> $$dest"; \
	mkdir -p debian/wayparam-gui/usr/bin "$$(dirname "$$dest")"; \
	mv "$$script" debian/wayparam-gui/usr/bin/; \
	mv "$$pkgdir" "$$dest"
